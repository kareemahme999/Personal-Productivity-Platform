# --- App ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000
# Comma-separated. Add your GitHub Pages origin in production, e.g.
# CORS_ORIGIN=https://YOUR_USER.github.io
CORS_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/aura?schema=public
# Tests use aura_test (see backend/tests/setup.ts). Override with TEST_DATABASE_URL if needed.

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-32b+
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Email (password reset; leave empty to run in dev mode with printed reset link) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Aura <noreply@example.com>

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
