# Copy to .env.local if you need to point the SPA at a remote API.
# Leave unset for local development — Vite proxies /api and /uploads to http://localhost:5000.

# Example production (GitHub Pages talking to a hosted API):
# VITE_API_URL=https://your-aura-api.onrender.com

# Optional. GitHub Actions sets this automatically to /<repo-name>/ for project Pages.
# VITE_BASE_PATH=/Personal-Productivity-Platform/
